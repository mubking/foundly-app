# Copy to .env.local and fill in real values. NEVER commit .env.local.
# EXPO_PUBLIC_* values are inlined into the app binary, so only ever use
# public values here (no secrets).
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
# Google "Web client" OAuth ID — public by design, but leave unset until
# configured so Google sign-in fails loudly instead of silently.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
