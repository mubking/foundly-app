{
  "expo": {
    "name": "Reunio",
    "slug": "foundly",
    "version": "1.0.0",
    "scheme": "foundly",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9FC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foundly.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Reunio uses your camera so you can photograph lost or found items and verify claims.",
        "NSPhotoLibraryUsageDescription": "Reunio needs access to your photos so you can attach images to lost and found reports and claims.",
        "NSLocationWhenInUseUsageDescription": "Reunio uses your location to show lost and found items near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#142D5C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.foundly.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ac71f9f9-2597-4dc4-ba20-408fc2b3800a"
      }
    },
    "owner": "mubking"
  }
}
