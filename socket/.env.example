# Port the Socket.IO server listens on. Must differ from backend/ (3000).
PORT=4000

# Same database the Next.js backend uses.
MONGODB_URI=mongodb://localhost:27017/foundly

# Must be byte-for-byte identical to backend/.env.local's JWT_SECRET —
# this service verifies tokens issued by the backend, it does not issue
# its own.
JWT_SECRET=

# Comma-separated list of allowed origins for Socket.IO's CORS check.
# Include whatever the mobile app / any admin web client connects from.
CORS_ORIGIN=http://localhost:3000,http://192.168.0.144:3000

# backend/'s REST API base. handlers/chat.js delegates message creation to
# POST {BACKEND_API_URL}/chat/messages rather than duplicating that logic —
# point this at wherever backend/ is actually reachable (same host as this
# service by default; use the LAN IP if they run on different machines).
BACKEND_API_URL=http://localhost:3000/api

NODE_ENV=development
