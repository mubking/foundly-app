# Copy to .env.local and fill in real values. NEVER commit .env.local.
# All values below are placeholders; the backend throws on missing required
# variables (see src/lib/{db,jwt,cloudinary,googleAuth,appleAuth}.js).

# MongoDB connection string. If it includes credentials, use a dedicated
# user/pass that can be rotated independently.
MONGODB_URI=mongodb://localhost:27017/foundly

# Long random string — MUST be byte-for-byte identical to socket/.env's
# JWT_SECRET (the socket service verifies tokens this backend issues).
JWT_SECRET=change-me-to-a-long-random-secret

# Signed-token lifetime, e.g. 7d.
JWT_EXPIRES_IN=7d

# Public API base URL clients call.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI (AI auto-describe on item reports)
OPENAI_API_KEY=

# SMTP (e.g. Gmail app password) — if unset, mail is logged in dev and
# sending throws in production (see src/lib/mailer.js).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Foundly <no-reply@foundly.app>

# OAuth
# Google "Web client" ID from Google Cloud Console.
GOOGLE_CLIENT_ID=
# Apple client identifier(s), comma-separated; native iOS uses the bundle id
# (must match mobile/app.json's "bundleIdentifier").
APPLE_CLIENT_ID=com.foundly.app
